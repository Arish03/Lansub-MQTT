# PostgreSQL Database Configuration
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=mqtt
DATABASE_URL=postgresql+asyncpg://app:app_secret@db:5432/mqtt

# Application Security & Token Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Secret Key for Encrypting Broker Credentials at Rest (Fernet key)
FERNET_KEY=vX1K4-z8_hYQ3mK6_2j8b1n3P9q7xW4_k5M8r0T2y1A=

# Default Admin Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminSecurePassword123!

# Host Port Mapping (Change these to any open ports on your VM)
FRONTEND_PORT=7000
BACKEND_PORT=7001
MQTT_PORT=7003
MQTT_WS_PORT=7004
DB_PORT=7005

# Local Mosquitto Broker Configuration (Container internal)
MQTT_DEFAULT_HOST=mosquitto
MQTT_DEFAULT_PORT=1883

# Frontend Public API & WebSocket Endpoints (Browser connects to BACKEND_PORT)
# Note: For Azure VM remote access, replace 'localhost' with your Azure VM Public IP or Domain
NEXT_PUBLIC_API_URL=http://localhost:7001
NEXT_PUBLIC_WS_URL=ws://localhost:7001/ws
